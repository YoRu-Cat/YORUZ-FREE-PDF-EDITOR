# Copy to .env and adjust. Every value is optional.
PDFE_HOST=127.0.0.1
PDFE_PORT=8000
# Folder for uploaded documents and undo history
PDFE_DATA_DIR=./data
PDFE_MAX_UPLOAD_MB=100
# Idle documents are deleted after this many minutes
PDFE_SESSION_TTL_MINUTES=240
PDFE_CLEANUP_INTERVAL_SECONDS=300
PDFE_MAX_UNDO=50
PDFE_DOC_CACHE_SIZE=8
PDFE_MAX_RENDER_SCALE=4
# Only needed if the frontend is served from a different origin
PDFE_CORS_ORIGINS=
PDFE_LOG_LEVEL=info
PDFE_WORKERS=1
PDFE_OPEN_BROWSER=1
